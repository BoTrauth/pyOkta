# Okta Configuration Template
# Copy this file to .env.dev, .env.qa, or .env.prev and fill in your actual values

# Okta Organization URL (e.g., https://your-org.okta.com)
OKTA_ORG_URL=https://your-org.okta.com

# OAuth 2.0 Private Key Authentication
# Client ID from your Okta application
OKTA_CLIENT_ID=your_client_id

# Private Key - Copy the full JSON from your Okta application
# This should be the complete JSON object containing d, p, q, dp, dq, qi, kty, e, kid, and n
OKTA_PRIVATE_KEY='{"d": "your_private_key_data", "p": "...", "q": "...", "dp": "...", "dq": "...", "qi": "...", "kty": "RSA", "e": "AQAB", "kid": "your_key_id", "n": "..."}'

# Scopes (comma-separated)
OKTA_SCOPES=okta.users.manage,okta.groups.manage,okta.apps.manage

# Protected Resources - Resources that won't be deleted during cleanup operations
# User emails that should not be deleted
PROTECTED_USER_EMAILS=admin@example.com,important.user@example.com

# Application IDs that should not be deleted (comma-separated)
PROTECTED_APP_IDS=app_id_1,app_id_2,app_id_3

# Group IDs that should not be deleted (comma-separated)
PROTECTED_GROUP_IDS=group_id_1,group_id_2
